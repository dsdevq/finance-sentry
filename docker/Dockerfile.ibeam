# IBeam + Client Portal Gateway with our conf.yaml baked in.
#
# The upstream `voyz/ibeam` image ships CPG's default conf.yaml, which
# allowlists `172.17.0.*` (the Docker default-bridge subnet) only. Our compose
# network sits on a different subnet (e.g. `172.18.0.*`), so cross-container
# requests from the API to the spawned gateway were silently rejected as 404 —
# authenticated=true internally, but every /v1/api/* path unreachable from
# outside. Baking in a conf.yaml that allows the broader `172.*` range fixes
# that without reintroducing the host bind-mount that #248 (correctly) removed.
# Base 0.5.12 + PR #277 applied on top (vendored under ibkr/ibeam-pr277/).
#
# Why not a released tag: accounts with multiple 2FA methods hit IBKR's
# "Select Second Factor Device" dropdown, which 0.5.12 can't handle (issue
# #271 — login times out on that screen). The maintainer's PR #277 build
# (voyz/ibeam:0.5.11-rc1) handles the dropdown but forks before the #283
# race fix, so it misreads "Client login succeeds" during the SPA re-render,
# closes the browser before the IB Key push is approved, and loops forever
# re-prompting the user's phone. We need both fixes, so: 0.5.12 base + the
# PR #277 files (they apply cleanly onto v0.5.12) copied over site sources.
# Drop the overlay once PR #277 is merged and released upstream.
FROM voyz/ibeam:0.5.12

COPY ibkr/ibeam-pr277/ibeam_starter.py /srv/ibeam/ibeam_starter.py
COPY ibkr/ibeam-pr277/var.py /srv/ibeam/src/var.py
COPY ibkr/ibeam-pr277/handlers/login_handler.py /srv/ibeam/src/handlers/login_handler.py
COPY ibkr/ibeam-pr277/login/targets.py /srv/ibeam/src/login/targets.py

COPY ibkr/conf.yaml /srv/clientportal.gw/root/conf.yaml
