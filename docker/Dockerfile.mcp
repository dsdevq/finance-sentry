# syntax=docker/dockerfile:1
# Multi-stage build for FinanceSentry MCP server
# Build context: repository root

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:9.0-alpine AS build
WORKDIR /src

COPY backend/ backend/

WORKDIR /src/backend
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore FinanceSentry.sln

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish src/FinanceSentry.Mcp/FinanceSentry.Mcp.csproj -c Release -o /app/publish

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:9.0-alpine AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENV DOTNET_RUNNING_IN_CONTAINER=true

ENTRYPOINT ["dotnet", "FinanceSentry.Mcp.dll"]
