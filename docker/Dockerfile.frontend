# Angular development server
# Build context: repository root

FROM node:22-alpine

WORKDIR /app

# Install dependencies first (layer cached until package.json changes)
COPY frontend/package*.json frontend/.npmrc ./
# @lifekit-hq/* packages come from npm.pkg.github.com; token via BuildKit secret
RUN --mount=type=secret,id=npm_token \
    NODE_AUTH_TOKEN=$(cat /run/secrets/npm_token) npm install

# Copy source
COPY frontend/ ./

EXPOSE 4200

# --host 0.0.0.0 required to accept connections from outside the container
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200"]
