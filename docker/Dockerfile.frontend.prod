# Production frontend image — multi-stage:
#   1. build: node:22-alpine builds the @dsdevq-common workspace libs + the
#      Angular app in production mode.
#   2. serve: nginx:alpine serves the SPA with proper history-mode fallback.
#
# Build context: repository root.

# ─── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

# Copy the entire frontend tree FIRST so that npm install discovers the
# `projects/dsdevq-common/*` workspaces and creates the symlinks in
# node_modules/@dsdevq-common/. Copying package.json alone (as the dev image
# does) skips the workspaces and breaks `@dsdevq-common/config/tailwind`,
# `@dsdevq-common/ui` etc. at build time.
COPY frontend/ ./

RUN npm install --no-audit --no-fund

# Build the UI library first so the application's lazy imports resolve.
RUN npm run build:lib

# Produce production bundle (dist/finance-sentry/browser/).
RUN npm run build:prod

# ─── Stage 2: serve ────────────────────────────────────────────────────────────
FROM nginx:alpine AS serve

# Default config: SPA fallback to index.html, proxy /api → the api container.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/finance-sentry.conf

# Copy the built artifacts. The output path comes from angular.json's
# `outputPath` for the `finance-sentry` project — Angular 17+ defaults to
# `<outputPath>/browser`.
COPY --from=build /app/dist/finance-sentry/browser /usr/share/nginx/html

EXPOSE 4200
