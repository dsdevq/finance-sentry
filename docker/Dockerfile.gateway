# syntax=docker/dockerfile:1
# Multi-stage build for the FinanceSentry edge gateway (feature 025 — YARP reverse proxy).
# Build context: repository root.

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

COPY backend/ backend/

WORKDIR /src/backend
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore src/FinanceSentry.Gateway/FinanceSentry.Gateway.csproj

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish src/FinanceSentry.Gateway/FinanceSentry.Gateway.csproj -c Release -o /app/publish

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENV DOTNET_RUNNING_IN_CONTAINER=true
# Plain HTTP on 8080 by default. TLS/ACME activates only when LettuceEncrypt:DomainNames is set
# (see appsettings.json); in that mode also publish 80/443 in compose.
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

# Container-level liveness for the single-point-of-failure gateway (spec edge case).
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD wget -q -O /dev/null http://localhost:8080/gateway/health || exit 1

ENTRYPOINT ["dotnet", "FinanceSentry.Gateway.dll"]
