{
  "uid": "fs-retention-backups",
  "title": "Finance Sentry · Retention & backups",
  "tags": ["finance-sentry", "retention", "backups", "feature-024"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last provably-restorable backup (age)",
      "description": "Seconds since the most recent backup a restore drill proved (SC-002). Red past a week.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 604800 },
              { "color": "red", "value": 1209600 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "finance_backup_last_verified_age_seconds" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last verified backup (timestamp)",
      "description": "When the last provably-restorable backup was taken (SC-002).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "finance_backup_last_verified_timestamp * 1000" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retention purge last-run age",
      "description": "Seconds since the last successful generic retention run (SC-005).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 172800 },
              { "color": "red", "value": 259200 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(finance_retention_last_run_age_seconds)" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rows removed by retention (per table)",
      "description": "Increase in rows purged per governed table.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (table) (increase(finance_retention_rows_removed_total[$__rate_interval]))", "legendFormat": "{{table}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Retention & backup job failures",
      "description": "Failed runs of the retention/backup/restore-verify jobs (feeds the Telegram alert path).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (job) (increase(finance_jobs_failed_total{job=~\"RetentionPurgeJob.*|BackupJob.*|RestoreVerifyJob.*\"}[$__rate_interval]))", "legendFormat": "{{job}}" }
      ]
    }
  ]
}
