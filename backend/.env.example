# Finance Sentry environment variables
# Copy to .env and fill in real values (never commit .env)

# URL of the Finance Sentry REST API (used by FinanceSentry.Mcp to call live data)
FINANCE_SENTRY_API_URL=http://localhost:5001

# Bearer token for authenticating MCP server → API requests
FINANCE_SENTRY_API_TOKEN=your-bearer-token-here
