# Finance Sentry — environment variable reference
# Copy to .env and fill in real values. Never commit .env.

# MCP server — URL of the Finance Sentry REST API and a service token
# used by FinanceSentry.Mcp when live tool implementations call the API.
FINANCE_SENTRY_API_URL=http://localhost:5001/api/v1
FINANCE_SENTRY_API_TOKEN=your-service-token-here
