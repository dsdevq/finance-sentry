{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Gateway": {
    "RateLimits": {
      "Auth": { "PermitPerMinute": 10 },
      "Webhook": { "PermitPerMinute": 60 }
    }
  },

  "LettuceEncrypt": {
    "DomainNames": [],
    "EmailAddress": "",
    "AcceptTermsOfService": false
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "api",
        "Order": 0,
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "webhook-route": {
        "ClusterId": "api",
        "Order": 0,
        "RateLimiterPolicy": "webhook",
        "Match": { "Path": "/api/webhook/{**catch-all}" }
      },
      "api-route": {
        "ClusterId": "api",
        "Order": 1,
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "hangfire-route": {
        "ClusterId": "api",
        "Order": 1,
        "Match": { "Path": "/hangfire/{**catch-all}" }
      },
      "mcp-route": {
        "ClusterId": "mcp",
        "Order": 1,
        "Match": { "Path": "/mcp/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/mcp" }
        ]
      },
      "frontend-route": {
        "ClusterId": "frontend",
        "Order": 100,
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api-1": { "Address": "http://api:5000/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/v1/health"
          },
          "Passive": {
            "Enabled": "true",
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        }
      },
      "mcp": {
        "Destinations": {
          "mcp-1": { "Address": "http://mcp:5100/" }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": "true",
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        }
      },
      "frontend": {
        "Destinations": {
          "frontend-1": { "Address": "http://frontend:4200/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/"
          }
        }
      }
    }
  }
}
