{
  "extends": "@lifekit-hq/config/tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "google.accounts",
      "vitest/globals"
    ],
    "paths": {
      "@core/*": [
        "./src/app/core/*"
      ],
      "@shared/*": [
        "./src/app/shared/*"
      ],
      "@modules/*": [
        "./src/app/modules/*"
      ]
    }
  },
  "exclude": [
    "**/*.stories.ts"
  ]
}
