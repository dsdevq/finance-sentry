# Finance Sentry MCP Server environment variables.
# Copy this file to .env and fill in values before running the MCP server.

# Transport protocol used by the MCP server.
# Valid values: stdio (default, used by Claude Desktop / CLI clients)
#               http  (SSE-over-HTTP, for networked or multi-client deployments)
MCP_TRANSPORT=stdio

# TCP port the MCP server listens on when MCP_TRANSPORT=http.
# Ignored when MCP_TRANSPORT=stdio.
# Default: 5100
MCP_HTTP_PORT=5100

# PostgreSQL connection string used by the MCP server to query Finance Sentry data.
# Format: Host=<host>;Port=5432;Database=finance_sentry;Username=<user>;Password=<pass>
# Example (local Docker stack): Host=localhost;Port=5432;Database=finance_sentry;Username=finance_user;Password=finance_password
MCP_CONNECTION_STRING=Host=localhost;Port=5432;Database=finance_sentry;Username=finance_user;Password=change-this-in-production
